{
  "name": "@dolphago/feature-workflow-harness",
  "version": "0.1.0",
  "description": "feature-workflow unattended orchestration harness for PLAN/STATE/NOTES workflows",
  "type": "module",
  "private": true,
  "bin": {
    "fw": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:nulz": "node scripts/check-nulz.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
